# =====================================================================
# Variables de entorno globales - Microservicio Pólizas Colectiva
# =====================================================================
SERVER_PORT=8082
APP_ZONA_HORARIA=America/Bogota
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# ---------- Seguridad ----------
API_KEY_HEADER=x-api-key
API_KEY=123456
SECURITY_JWT_ENABLED=true
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/seguros-bolivar
KEYCLOAK_JWK_SET_URI=http://localhost:8180/realms/seguros-bolivar/protocol/openid-connect/certs

# ---------- CORE (monolito modular) ----------
CORE_BASE_URL=http://localhost:8080
CORE_API_KEY=123456
CORE_CONNECT_TIMEOUT=3s
CORE_RESPONSE_TIMEOUT=10s
CORE_RETRY_MAX_ATTEMPTS=3
CORE_RETRY_INITIAL_BACKOFF=300ms
CORE_RETRY_MAX_BACKOFF=3s
CORE_RETRY_JITTER=0.5

# ---------- Circuit breaker ----------
CB_SLIDING_WINDOW_SIZE=20
CB_MINIMUM_CALLS=10
CB_FAILURE_RATE_THRESHOLD=50
CB_SLOW_CALL_DURATION=3s
CB_SLOW_CALL_RATE_THRESHOLD=80
CB_WAIT_OPEN_STATE=30s
CB_HALF_OPEN_CALLS=3

# ---------- Kafka (eventos en tiempo real) ----------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTOS=polizas.eventos
KAFKA_GROUP=polizas-colectivas
KAFKA_LISTENERS_ENABLED=true
KAFKA_LISTENER_CONCURRENCY=1
KAFKA_MAX_POLL_RECORDS=50
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_RECONNECT_BACKOFF_MS=1000
KAFKA_RECONNECT_BACKOFF_MAX_MS=30000
